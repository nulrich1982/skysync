[Unit]
Description=SkySync: month-end lunch menu safety net (last day of month, Aug-May)
Documentation=file:/opt/skysync/repo/SETUP.md
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/vault
OnFailure=digest-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/skysync/repo
ExecStart=/opt/skysync/venv/bin/python -m skysync.menu.cli --config /opt/skysync/config.toml
TimeoutStartSec=5min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skysync-menu-monthend
